{
    "name": "file-bus",
    "displayName": "%displayName%",
    "description": "%description%",
    "version": "0.0.1",
    "publisher": "Sean Morris",
    "license": "Apache-2.0",
    "engines": {
        "vscode": "*"
    },
    "scripts": {
        "build:index": "npx babel index.js --out-dir dist/",
        "build:hack": "node build-hack.mjs",
        "compile": "npm run build:index && npm run build:hack"
    },
    "hacks": [
        "hack.js"
    ],
    "activationEvents": [
        "*"
    ],
    "browser": "dist/index",
    "main": "dist/index",
    "enabledApiProposals": [
        "fileSearchProvider"
    ],
    "devDependencies": {
        "@babel/cli": "^7.24.8",
        "esbuild": "^0.28.0"
    },
    "contributes": {
        "commands": [
            {
                "command": "fileBus.console",
                "title": "fileBus.console"
            }
        ]
    },
    "dependencies": {
        "@babel/plugin-transform-modules-commonjs": "^7.25.7",
        "quickbus": "^1.0.0"
    }
}
